{
  "name": "crawlume",
  "version": "0.17.0",
  "private": true,
  "type": "module",
  "description": "Resumable web crawling and retrieval for AI agents",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=24.14.0"
  },
  "exports": {
    "./sdk": {
      "types": "./dist/sdk/client.d.ts",
      "default": "./dist/sdk/client.js"
    },
    "./sdk/webhooks": {
      "types": "./dist/sdk/webhooks.d.ts",
      "default": "./dist/sdk/webhooks.js"
    }
  },
  "bin": {
    "crawlume": "./dist/cli/main.js",
    "crawlume-mcp": "./dist/server.js",
    "crawlume-auth": "./dist/cli/auth.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:postgres": "sh scripts/test-control-plane-postgres.sh",
    "test:watch": "vitest",
    "start": "node dist/server.js",
    "start:control-plane": "node dist/server.js --control-plane",
    "auth": "tsx src/cli/auth.ts",
    "bench": "tsx benchmarks/controlled-site/server.ts --runner benchmark-suite",
    "bench:optimize": "tsx benchmarks/optimization/runner.ts",
    "bench:case": "tsx benchmarks/controlled-site/server.ts --runner reader-case",
    "bench:corpus": "tsx benchmarks/controlled-site/server.ts --runner reader-corpus",
    "bench:faults": "vitest run tests/controlled-fault-matrix.test.ts",
    "bench:http": "tsx benchmarks/harness/summary.ts",
    "bench:readiness": "tsx benchmarks/controlled-site/server.ts --runner readiness-tournament",
    "bench:soak": "tsx benchmarks/soak/runner.ts",
    "cli": "tsx src/cli/main.ts",
    "smoke": "tsx src/cli/smoke.ts",
    "trial:docs": "node benchmarks/docs-trial/run.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1147.0",
    "@aws-sdk/s3-request-presigner": "3.1147.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@mozilla/readability": "0.6.0",
    "ipaddr.js": "2.2.0",
    "jose": "6.2.10",
    "jsdom": "30.0.1",
    "pdfjs-dist": "6.3.289",
    "pg": "8.23.0",
    "playwright-core": "1.62.1",
    "robots-parser": "3.0.1",
    "turndown": "7.2.4",
    "undici": "8.10.0",
    "web-bot-auth": "0.1.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@crawlee/cheerio": "3.16.0",
    "@crawlee/core": "3.16.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@types/jsdom": "28.0.1",
    "@types/node": "25.5.0",
    "@types/pg": "8.23.1",
    "@types/turndown": "5.0.6",
    "tsx": "4.20.5",
    "typescript": "5.9.3",
    "vitest": "3.2.4",
    "yaml": "2.8.1"
  }
}
